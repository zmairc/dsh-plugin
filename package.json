{
  "name": "@zmairc/persona-forge",
  "version": "0.1.2",
  "description": "把聊天记录蒸馏成可扮演的人设：给 DSH 加两个工具，forge_persona 生成人设、chat_persona 按人设对话。",
  "private": false,
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zmairc/dsh-plugin.git"
  },
  "homepage": "https://github.com/zmairc/dsh-plugin#readme",
  "bugs": {
    "url": "https://github.com/zmairc/dsh-plugin/issues"
  },
  "type": "module",
  "main": "dist/dsh/plugin.js",
  "exports": {
    ".": "./dist/dsh/plugin.js"
  },
  "engines": {
    "node": ">=23.6"
  },
  "bin": {
    "personaforge": "dist/cli/index.js",
    "personaforge-mcp": "dist/mcp/server.js"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "persona",
    "chat-history",
    "style-transfer"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "examples/public"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "prepublishOnly": "node scripts/build.ts",
    "test": "node --test \"tests/*.test.ts\"",
    "smoke": "node scripts/smoke.ts",
    "stats": "node src/cli/index.ts stats",
    "chat": "node src/cli/index.ts chat",
    "forge": "node src/cli/index.ts forge",
    "mcp": "node src/mcp/server.ts"
  },
  "dependencies": {
    "@zmairc/persona-forge": "file:zmairc-persona-forge-0.1.2.tgz"
  }
}
